{
  "name": "pubky-ring-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "build": "tsc && vite build",
    "check": "tsc",
    "dev": "vite",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/pubky.test.js",
    "test:compatibility": "tsc -p tsconfig.test.json && node --test test/sdk-compatibility.test.mjs"
  },
  "dependencies": {
    "@synonymdev/pubky": "^0.15.0",
    "jdenticon": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.1"
  }
}
